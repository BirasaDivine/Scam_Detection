# These are environment variables, set in the Render dashboard or in PowerShell.
# Nothing reads this file automatically.

# Address of the frontend, allowed by CORS. Separate several with commas.
SCAMGUARD_ALLOWED_ORIGIN=http://localhost:5173
# Seconds before /analyze gives up.
SCAMGUARD_TIMEOUT_SECONDS=20
# Set to 1 on a server so it refuses to start without the model files, instead of using the mock.
SCAMGUARD_REQUIRE_MODEL=0
# Folder with the model files. Defaults to backend/model.
# SCAMGUARD_MODEL_DIR=
# Postgres address for the counts, for example from Neon or Supabase.
# Without it, counts go to backend/data/scamguard.db (SQLite), which Render wipes on every restart.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Secret that unlocks GET /stats and the hidden Insights page. Without it, /stats is off.
# SCAMGUARD_ADMIN_TOKEN=
